"use client";

import { useCallback, useEffect, useState } from "react";
import { AnimatePresence } from "framer-motion";
import { CinematicLoader } from "./cinematic-loader";

/** The intro has its own state so opening it never rerenders the whole homepage. */
export function HomeIntro() {
  const [visible, setVisible] = useState(false);
  const finish = useCallback(() => {
    setVisible(false);
    try { sessionStorage.setItem("hasVisitedKS", "true"); } catch { /* Optional persistence. */ }
  }, []);
  useEffect(() => {
    try {
      if (sessionStorage.getItem("hasVisitedKS")) return;
    } catch { /* Storage can be unavailable in private/embedded browsers. */ }

    const start = setTimeout(() => setVisible(true), 0);
    return () => {
      clearTimeout(start);
    };
  }, []);
  return <AnimatePresence>{visible && <CinematicLoader onComplete={finish} />}</AnimatePresence>;
}
