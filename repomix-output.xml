<file path="src/app/globals.css">
@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  /* PURANA: --font-geist-sans: "Montserrat", ui-sans-serif, system-ui, sans-serif; */
  /* NAYA: */
  --font-geist-sans: var(--font-montserrat), ui-sans-serif, system-ui, sans-serif;
  
  --font-geist-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  --radius: 0.625rem;
  --background: oklch(1 0 0);
  --foreground: oklch(0.145 0 0);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.145 0 0);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.145 0 0);
  --primary: #ffffff;
  --primary-foreground: oklch(0.985 0 0);
  --secondary: oklch(0.97 0 0);
  --secondary-foreground: oklch(0.205 0 0);
  --muted: oklch(0.97 0 0);
  --muted-foreground: oklch(0.556 0 0);
  --accent: #e31e24;
  --accent-foreground: #ffffff;
  --destructive: oklch(0.577 0.245 27.325);
  --border: oklch(0.922 0 0);
  --input: oklch(0.922 0 0);
  --ring: oklch(0.708 0 0);
  --chart-1: oklch(0.646 0.222 41.116);
  --chart-2: oklch(0.6 0.118 184.704);
  --chart-3: oklch(0.398 0.07 227.392);
  --chart-4: oklch(0.828 0.189 84.429);
  --chart-5: oklch(0.769 0.188 70.08);
  --sidebar: oklch(0.985 0 0);
  --sidebar-foreground: oklch(0.145 0 0);
  --sidebar-primary: oklch(0.205 0 0);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.97 0 0);
  --sidebar-accent-foreground: oklch(0.205 0 0);
  --sidebar-border: oklch(0.922 0 0);
  --sidebar-ring: oklch(0.708 0 0);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  html {
    overflow-x: hidden;
  }
  body {
    @apply bg-background text-foreground;
    font-family: var(--font-geist-sans);
  }
}

/* ── ScrollFloat — subtle per-character reveal ── */
.sf-container {
  overflow: hidden;
}

.sf-text {
  display: inline-block;
  font-size: clamp(1.8rem, 7vw, 4.5rem);
  line-height: 1.35;
}

.sf-char {
  display: inline-block;
  opacity: 0;
  will-change: transform, opacity;
}

.sf-word {
  display: inline-block;
  /* Prevents mid-word line breaks */
}

/* ── Programs Section — editorial design ── */
.text-ink {
  color: #18181b;
}

.text-accent {
  color: var(--accent);
}

.editorial-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.03em;
}

.font-display {
  font-family: "Playfair Display", serif;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.service-tile {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding: 2rem 0;
  border-bottom: 1px solid #f4f4f5;
  cursor: pointer;
  position: relative;
  transition: padding 0.3s ease;
}

.service-tile:hover {
  padding-left: 0.5rem;
}

.service-image-hover {
  position: fixed;
  width: 280px;
  height: 340px;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.92);
  transition: opacity 0.35s ease, transform 0.35s ease;
  z-index: 40;
}

.service-tile:hover .service-image-hover {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

@media (max-width: 1023px) {
  .service-image-hover {
    display: none;
  }
}

/* ── Programs title — smooth italic via skew (font-style can't transition) ── */
.program-title {
  transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.service-tile:hover .program-title {
  transform: skewX(-3deg);
}

/* ── HOD Cards ── */
.hod-card-wrapper {
  will-change: transform;
  backface-visibility: hidden;
  -webkit-font-smoothing: antialiased;
}

.hod-card-photo {
  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.hod-card-wrapper:hover .hod-card-photo {
  transform: scale(1.03);
}

/* ── Placement marquee ── */
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@keyframes marquee-reverse {
  0% { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

.animate-marquee {
  animation: marquee 30s linear infinite;
}

.animate-marquee-reverse {
  animation: marquee-reverse 35s linear infinite;
}

/* ── Bento Card Styles ── */
.bento-card {
  background-color: #f0f0f2;
  border-radius: 32px;
  padding: 2rem;
  border: 1px solid rgba(0, 0, 0, 0.08);
  transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.bento-card:hover {
  box-shadow: 0 25px 50px -12px rgba(227, 30, 36, 0.08);
  transform: translateY(-4px);
}

/* Performance Improvements */
img {
  image-rendering: -webkit-optimize-contrast;
}

.bento-card {
  contain: layout style paint;
}

/* Reduce heavy animations on mobile */
@media (max-width: 768px) {
  .hod-card-wrapper:hover .hod-card-photo {
    transform: none;
  }
}
</file>

